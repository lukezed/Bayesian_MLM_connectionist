@article{yang2025obstaca,
  title = {Obstacles to In-Service {{Chinese}} High School Mathematics Teachers' Implementation of Mathematical Modelling in Classrooms: An Empirical Investigation of Teachers' Perspectives},
  author = {Yang, {\relax XR} and Li, {\relax XS} and Deng, {\relax ZJ} and Kaiser, G},
  year = 2025,
  month = jun,
  journal = {ZDM-MATHEMATICS EDUCATION},
  volume = {57},
  number = {2-3},
  pages = {535--551},
  issn = {1863-9690},
  doi = {10.1007/s11858-025-01660-9},
  abstract = {This mixed-method study uses interviews and an online questionnaire to investigate the obstacles that hinder teachers' implementation of mathematical modelling in everyday classrooms in China. Thirty high school mathematics teachers were interviewed, and 200 teachers completed an online questionnaire regarding their perceived obstacles. We identified six critical obstacle groups: missed opportunities to learn mathematical modelling education in professional development and/or teacher education; students' lack of knowledge and interests; lack of examples in textbooks; lack of suitable teaching materials; non-favourable curricula tradition and school policies; and a strong traditional focus on examination culture. The obstacles identified and their relationship to and role in current in-service teachers' practices are explored and interpreted from a sociocultural perspective considering, among other factors, the significance of central examinations in China and the historical prevalence of pure, structurally oriented mathematics in school.}
}

